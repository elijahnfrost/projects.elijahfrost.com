# Cloudflare — used by /api/projects (server-side only)
CF_ZONE_ID=

# Option A — API token (recommended). Create at Cloudflare → My Profile → API Tokens → Custom token:
#   Zone → Zone → Read, Zone → DNS → Read (and DNS → Edit if you use the DNS script)
#   Include → Specific zone → elijahfrost.com
CF_API_TOKEN=

# Option B — instead of CF_API_TOKEN, use Global API Key + account email (My Profile → API Keys).
# Do NOT put the Global Key in CF_API_TOKEN — that causes "Authentication error".
# CF_AUTH_EMAIL=you@example.com
# CF_GLOBAL_API_KEY=
